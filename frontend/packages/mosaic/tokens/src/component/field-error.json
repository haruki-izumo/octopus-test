{
    "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
    "field-error": {
        "color": {
            "content": {
                "default": {
                    "$value": "{color.content.danger}"
                }
            }
        },
        "spacing": {
            "stack": {
                "$value": "{spacing.1}"
            }
        },
        "typography": {
            "$value": "{typography.body-small}"
        }
    }
}
